# Base URL of the backend API (see backend/.env.example for the server's own PORT).
#
# - Simulator/emulator on the same machine as the backend: http://localhost:4000
# - Physical device (Expo Go / dev build): use your computer's LAN IP instead of
#   localhost, e.g. http://192.168.1.23:4000 — the phone can't resolve "localhost"
#   to your machine. Find your LAN IP with `ipconfig` (Windows) or `ifconfig`/`ip a`
#   (macOS/Linux), and make sure the backend's CORS_ORIGIN allows the device/tunnel
#   origin you're testing from.
EXPO_PUBLIC_API_URL=http://localhost:4000

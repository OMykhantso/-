# Port 5433 (not 5432) to avoid clashing with a native Postgres already
# running on your machine — see docker-compose.yml's db.ports.
DATABASE_URL="postgresql://delivery:delivery@localhost:5433/delivery?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
AVG_SPEED_KMH=28
STOP_HANDLING_MINUTES=5
